# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_OAUTH_CLIENT_ID: OAuth 2.0 Client ID for Google Workspace (Gmail, Calendar, Drive).
# Set your real Client ID in the AI Studio Secrets panel (.env).
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# GITHUB_REPO & GITHUB_TOKEN: Optional repository ("owner/repo") and PAT for GitHub Actions CI/CD push.
# GITHUB_REPO=owner/mythos-v6
# GITHUB_TOKEN=YOUR_GITHUB_PAT
# GITHUB_BRANCH=dev/mythos-v6-upgrade
