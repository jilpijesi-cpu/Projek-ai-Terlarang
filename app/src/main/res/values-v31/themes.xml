<resources>
    <!-- Android 12+: splash sistem memakai latar & maskot yang sama dengan intro, jadi peralihannya mulus. -->
    <style name="Theme.Mythos" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mythos_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/mythos_window</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
